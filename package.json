{
  "name": "legal-compliance-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Legal Document Discovery & Compliance Engine - PostgreSQL + Qdrant + Ollama + Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db.mjs init",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "node scripts/db.mjs test",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "setup": "npm run db:init && npm run seed",
    "e2e": "tsx --env-file=.env.local scripts/e2e.ts",
    "calibrate": "tsx --env-file=.env.local scripts/calibrate.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.15.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
